# Copy to .env to override the docker-compose defaults.
# None of these are secrets - they only configure the local throwaway
# test database and WordPress admin account inside Docker.

WP_PORT=8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
